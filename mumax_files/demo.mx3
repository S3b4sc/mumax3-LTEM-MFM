// Skyrmion / domain texture demo

SetGridsize(300, 300, 1)          // larger grid to allow textures to form
SetCellsize(4e-9, 4e-9, 0.9e-9)     // small cell size for good resolution (nm)
SetPBC(1,1,0)                     // Periodic Boundary Conditions

Msat  = 80e5                     // saturation magnetization (A/m)
Aex   = 4e-11                    // exchange stiffness (J/m)
alpha = 0.8                       // damping
//gammaLL = 2.211e5                 // gyromagnetic ratio

// DMI strength (interfacial)
Dind = 0.8e-3                       // J/m^2, try 1e-3 – 4e-3 for skyrmions

// Uniaxial anisotropy
Ku1  = 3e5                      // anisotropy constant (J/m^3)
//Ku1 = Ku1.LoadFile("Ku_map.txt")
anisU = vector(0, 0, 1)           // easy axis along z

// External magnetic field
B_ext = vector(0, 0, 0.5)         // Tesla, stabilizes skyrmions

// Temperature
//Temp = 300       // Kelvin

// Initial magnetization: random to allow textures
m = RandomMag()

// Relax the system
//Minimize()
Relax()

// Save final state
SaveAs(m, "final.ovf")


