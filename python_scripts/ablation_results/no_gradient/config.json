{
  "name": "no_gradient",
  "description": "Sin gradiente en entrada, solo tensor estructura",
  "model_config": {
    "use_gradient": false,
    "use_coherence": true
  },
  "loss_weights": {
    "regression": 1.0,
    "spectral_sigma": 0.0,
    "mz_var_sigma": 0.0
  },
  "training_params": {
    "epochs": 100,
    "use_amp": true,
    "use_annealing": false,
    "warmup_epochs": 10
  }
}