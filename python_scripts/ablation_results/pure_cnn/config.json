{
  "name": "pure_cnn",
  "description": "CNN pura sin ninguna f\u00edsica (ni en entrada ni en loss)",
  "model_config": {
    "use_gradient": false,
    "use_coherence": false
  },
  "loss_weights": {
    "regression": 1.0,
    "spectral_sigma": 0.0,
    "mz_var_sigma": 0.0
  },
  "training_params": {
    "epochs": 100,
    "use_amp": true,
    "use_annealing": false,
    "warmup_epochs": 10
  }
}